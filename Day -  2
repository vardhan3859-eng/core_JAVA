/*calculator program using switch
import java.util.*;
public class calc {
    public static void main(String []args){
        Scanner sc= new Scanner(System.in);
        System.out.println("Enter the input of a and b");
        int a=sc.nextInt();
        int b=sc.nextInt();
        System.out.println("Enter the operation symbol");
        char s=sc.next().charAt(0);
        switch(s){
        case '+':
            System.out.println("The addition of a and b is:"+(a+b));
            break;
        case '-':
            System.out.println("The subtraction of a and b is:"+(a-b));
            break;
        case '/':
            System.out.println("The division of a and b is:"+(a/b));
            break;
        case '*':
            System.out.println("The multiplication of a and b is:"+(a*b));
            break;
        case '%':
            System.out.println("The modulus of a and b is:"+(a%b));
            break;
        default:
            System.out.println("Enter the symbols only(+,-,*,/)");
            break;
        }
        
    }
    
}

    
